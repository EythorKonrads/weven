#!/usr/bin/env python3
"""Run a command while holding BillSplitt's shared local-Supabase lock.

Usage: db-lock <command> [args...]

Every factory worktree talks to the same local Supabase containers, so two
jobs resetting the database at once would clobber each other's schema. The
gate's checks.sh wraps its database step in this lock; jobs wait their turn
here and run everything else in parallel. macOS has no flock(1), so this uses
Python's fcntl. The lock is released when the command exits, even on a crash.
"""

import fcntl
import os
import subprocess
import sys
import tempfile
import time

if len(sys.argv) < 2:
    print(__doc__.strip(), file=sys.stderr)
    sys.exit(2)

path = os.path.join(tempfile.gettempdir(), "billsplitt-supabase.lock")
with open(path, "w") as lock:
    start = time.monotonic()
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("db-lock: another job is using the local database, waiting…", file=sys.stderr, flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        print(f"db-lock: got it after {int(time.monotonic() - start)}s", file=sys.stderr, flush=True)
    sys.exit(subprocess.call(sys.argv[1:]))
